---
import Layout from '../layouts/Layout.astro';
import InnerHero from '../components/InnerHero.astro';
import heroImage from '../assets/images/technician-nvr-monitoring-check.png';

const faqs = [
  {
    q: 'Do you charge for the IT infrastructure assessment?',
    a: 'No — the on-site walkthrough and written findings report are free for businesses across Greater Los Angeles. We quote any upgrade work separately afterward, and there\'s no obligation to hire us for it.'
  },
  {
    q: 'Is this the same as hiring an IT consultant or managed service provider?',
    a: 'Not exactly. We focus specifically on the physical infrastructure — cameras, door access, Wi-Fi, switches, firewalls, routers, and cabling — rather than help desk support, software, or cloud services. If your business also needs full managed IT, we coordinate with whoever handles that side rather than trying to cover it ourselves.'
  },
  {
    q: 'Do you assess door access control along with cameras and networking?',
    a: 'Yes. Card readers, keypads, video intercoms, and gate entry hardware are part of the same walkthrough — especially where they share power, wiring, or network gear with your cameras and Wi-Fi. We flag outdated readers, single-door workarounds, and integration gaps the same way we do for the rest of the system.'
  },
  {
    q: 'Do you specialize in UniFi or Cisco, or work with both?',
    a: 'Both. We assess and design around UniFi/Ubiquiti for most small and mid-size properties, and Cisco business-grade equipment where scale or client requirements call for it. Part of the assessment is telling you honestly which platform actually fits your budget and property, not defaulting to one brand.'
  },
  {
    q: 'What if our equipment is a mix of brands, ages, and past installers?',
    a: 'That\'s the normal case, not the exception. We document what\'s actually there, note what\'s still solid, and only recommend replacing what\'s genuinely holding you back — not a rip-and-replace of everything at once.'
  },
  {
    q: 'Can you prioritize upgrades across multiple business locations?',
    a: 'Yes. For multi-location businesses we assess each site individually, then help you sequence upgrades by urgency and budget rather than tackling every location at the same time.'
  },
  {
    q: 'How long does an IT infrastructure assessment take?',
    a: 'Most single-location walkthroughs take under two hours on-site. You\'ll get a written summary of findings and a prioritized upgrade roadmap within a few business days.'
  }
];
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};
const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "IT Infrastructure Consulting",
  "name": "IT Infrastructure Consulting & Upgrade Assessments — Los Angeles",
  "provider": { "@type": "LocalBusiness", "name": "NaMiSmart", "telephone": "+1-818-612-4117", "url": "https://namismart.com" },
  "areaServed": { "@type": "City", "name": "Los Angeles" },
  "description": "Free on-site IT infrastructure assessments — cameras, door access control, Wi-Fi, UniFi/Cisco switches, firewalls, routers, and cabling evaluated together with a prioritized upgrade plan — across Greater Los Angeles.",
  "offers": { "@type": "Offer", "priceCurrency": "USD", "description": "Free on-site IT infrastructure assessment" }
};
---

<Layout title="IT Infrastructure Consulting & Upgrades — LA" description="Free on-site IT infrastructure assessments for LA businesses — cameras, door access, Wi-Fi, UniFi/Cisco switches, firewalls, and routers evaluated together with a prioritized upgrade plan." ogImage="/images/og/og-it-consulting.png" breadcrumbs={[{name:'Home',url:'/'},{name:'IT Consulting',url:'/it-consulting'}]}>

<style>
  .sec{position:relative;z-index:4;padding:30px 56px 20px;}
  .eyebrow{font-family:'Space Mono',monospace;font-size:12px;letter-spacing:0.24em;color:#4DA6FF;margin-bottom:14px;}
  .grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}
  .grid2{display:grid;grid-template-columns:1fr 1fr;gap:20px;}
  .card{border:1px solid rgba(255,255,255,0.1);border-radius:14px;background:#0E131D;padding:22px;}
  .card h3{font-family:'Archivo',sans-serif;font-weight:700;font-size:16.5px;color:#fff;margin:0;}
  .card p{font-size:13.5px;line-height:1.55;color:#8B98AE;margin:8px 0 0;}
  .card-lg{border:1px solid rgba(255,255,255,0.1);border-radius:16px;background:linear-gradient(160deg,#0D1220,#0A0E17);padding:30px;}
  .card-lg h3{font-family:'Archivo',sans-serif;font-weight:800;font-size:24px;line-height:1.12;color:#fff;margin:0;}
  .card-lg p{font-size:14.5px;line-height:1.65;color:#98A4BA;margin:14px 0 0;}
  .tag-row{display:flex;flex-direction:column;gap:12px;justify-content:center;}
  .tri{display:flex;align-items:center;gap:14px;border:1px solid rgba(255,255,255,0.1);border-radius:14px;background:#0E131D;padding:16px 20px;}
  .tl{font-family:'Space Mono',monospace;font-size:11px;color:#4DA6FF;width:96px;letter-spacing:0.08em;}
  .tri span:last-child{font-size:13.5px;color:#B9C6DC;}
  .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}
  .step{border:1px solid rgba(255,255,255,0.1);border-radius:16px;background:#0E131D;padding:26px;position:relative;}
  .step .num{font-family:'Space Mono',monospace;font-size:12px;color:#4DA6FF;letter-spacing:0.1em;margin-bottom:12px;}
  .step h3{font-family:'Archivo',sans-serif;font-weight:800;font-size:18px;color:#fff;margin:0;}
  .step p{font-size:13.5px;line-height:1.6;color:#8B98AE;margin:8px 0 0;}
  .callout{border:1px solid rgba(77,166,255,0.22);border-radius:16px;background:linear-gradient(160deg,#0D1220,#0A0E17);padding:30px 34px;display:flex;align-items:center;justify-content:space-between;gap:28px;}
  .callout h3{font-family:'Archivo',sans-serif;font-weight:800;font-size:21px;color:#fff;margin:0;}
  .callout p{font-size:14.5px;line-height:1.6;color:#98A4BA;margin:8px 0 0;max-width:640px;}
  .callout a{white-space:nowrap;font-family:'Archivo',sans-serif;font-weight:700;font-size:14px;color:#4DA6FF;}
  .intro-block { max-width:760px; }
  .intro-block p { font-size:15px;line-height:1.75;color:#98A4BA;margin:0; }
  .faq-item { border:1px solid rgba(255,255,255,0.1);border-radius:14px;background:#0E131D;padding:20px 22px;margin-bottom:12px; }
  .faq-item summary { font-family:'Archivo',sans-serif;font-weight:700;font-size:16px;color:#fff;cursor:pointer;list-style:none; }
  .faq-item summary::-webkit-details-marker { display:none; }
  .faq-item summary::after { content:'+';float:right;color:#4DA6FF;font-weight:400; }
  .faq-item[open] summary::after { content:'−'; }
  .faq-item p { font-size:14px;line-height:1.65;color:#98A4BA;margin:12px 0 0; }
  @media(max-width:860px){
    .sec{padding:20px 16px;}
    .grid3,.grid2,.steps{grid-template-columns:1fr;}
    .callout{flex-direction:column;align-items:flex-start;}
  }
</style>

<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
<script type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} />

<InnerHero
  breadcrumb="IT CONSULTING"
  eyebrow="// IT INFRASTRUCTURE CONSULTING"
  title="One consultation."
  titleBlue="Every system covered."
  subtitle="We audit your cameras, door access, Wi-Fi, switches, firewalls, routers, and cabling together — then hand you a clear, prioritized plan for what to upgrade first, what to replace, and what's fine as-is."
  tags={['FREE ON-SITE ASSESSMENT','CAMERAS + DOOR ACCESS','UNIFI · CISCO EXPERTISE','UPGRADE ROADMAP']}
  ctaLabel="Request a Free IT Assessment →"
  ctaHref="/contact"
  secondaryLabel="Networking & Wi-Fi"
  secondaryHref="/networking-wifi"
  image={heroImage}
  imageAlt="Technician evaluating network equipment and camera monitors during an IT infrastructure assessment"
  statusLabel="ASSESSMENT · IN PROGRESS"
/>

<section class="sec">
  <div class="intro-block">
    <div class="eyebrow">// IT INFRASTRUCTURE CONSULTING — LOS ANGELES</div>
    <p>Most businesses don't need a dozen vendors — they need one team who can look at the cameras, door access, the network closet, the Wi-Fi, and the cabling together and say plainly what actually needs to change. NaMiSmart does full on-site IT infrastructure consultations for offices, hotels, retail, and commercial properties throughout Burbank and Greater Los Angeles: we evaluate your existing cameras, door access hardware, switches, firewalls, routers, access points, and cabling as one system — with hands-on expertise across both UniFi/Ubiquiti and Cisco business-grade equipment — flag what's outdated or undersized, and hand you a straightforward, prioritized upgrade plan — with no obligation to use us for the work itself.</p>
  </div>
</section>

<section class="sec">
  <div class="eyebrow">// WHAT WE ASSESS</div>
  <h2 style="font-family:'Archivo',sans-serif;font-weight:800;font-size:34px;letter-spacing:-0.02em;color:#fff;margin:0 0 22px">Every layer of the system, in one visit</h2>
  <div class="grid3">
    <div class="card"><h3>Switches &amp; routing</h3><p>Whether your UniFi or Cisco switches are managed, PoE-capable, and sized for current and future devices.</p></div>
    <div class="card"><h3>Firewalls &amp; segmentation</h3><p>Whether traffic is properly segmented — or everything sits on one flat, unprotected network.</p></div>
    <div class="card"><h3>Wi-Fi coverage</h3><p>Dead zones, overloaded access points, and consumer routers doing an enterprise job.</p></div>
    <div class="card"><h3>Cameras &amp; NVRs</h3><p>Recording gaps, storage limits, and camera traffic competing with everything else on the network.</p></div>
    <div class="card"><h3>Door access &amp; entry</h3><p>Outdated readers, single-door workarounds, and access hardware that doesn't talk to the rest of the system.</p></div>
    <div class="card"><h3>Cabling &amp; racks</h3><p>Undocumented, tangled, or undersized wiring that limits every device plugged into it.</p></div>
    <div class="card"><h3>Power &amp; uptime</h3><p>UPS coverage and backup power planning so a single outage doesn't take everything down.</p></div>
    <div class="card"><h3>UniFi &amp; Cisco fit</h3><p>Whether your current platform still matches your budget, scale, and where the property is headed.</p></div>
  </div>
</section>

<section class="sec">
  <div class="eyebrow">// HOW IT WORKS</div>
  <h2 style="font-family:'Archivo',sans-serif;font-weight:800;font-size:28px;letter-spacing:-0.02em;color:#fff;margin:0 0 22px">From walkthrough to upgrade plan</h2>
  <div class="steps">
    <div class="step"><div class="num">STEP 1</div><h3>On-site walkthrough</h3><p>We inspect your current cameras, door access hardware, network closet, switches, firewall, access points, and cabling in person.</p></div>
    <div class="step"><div class="num">STEP 2</div><h3>Findings report</h3><p>A plain-language rundown of what's working, what's outdated, and what's an actual risk — no jargon, no pressure.</p></div>
    <div class="step"><div class="num">STEP 3</div><h3>Upgrade roadmap</h3><p>A prioritized plan and quote, phased by budget if needed, so you decide what gets tackled first.</p></div>
  </div>
</section>

<section class="sec">
  <div class="grid2">
    <div class="card-lg">
      <div class="eyebrow">// WHY IT MATTERS</div>
      <h3>Piecemeal fixes cost more in the long run.</h3>
      <p>Replacing one switch, adding one access point, or patching one firewall rule in isolation often just moves the bottleneck somewhere else. We look at cameras, network, and cabling as one system, so the upgrade you make today isn't bottlenecked by something we didn't catch.</p>
    </div>
    <div class="tag-row">
      <div class="tri"><span class="tl">ONE VISIT</span><span>every system assessed in a single walkthrough</span></div>
      <div class="tri"><span class="tl">NO PRESSURE</span><span>a report and roadmap, not a sales pitch</span></div>
      <div class="tri"><span class="tl">PHASED PLANS</span><span>upgrade in stages that fit your budget</span></div>
    </div>
  </div>
</section>

<section class="sec" style="padding-bottom:10px">
  <div class="callout">
    <div>
      <h3>Already know what needs replacing?</h3>
      <p>Skip the full audit and go straight to networking, cabling, or camera installation — request a free estimate for the specific work you need.</p>
    </div>
    <a href="/contact">Request a Free Estimate →</a>
  </div>
</section>

<section class="sec">
  <div class="eyebrow">// IT CONSULTING FAQ</div>
  <h2 style="font-family:'Archivo',sans-serif;font-weight:800;font-size:28px;letter-spacing:-0.02em;color:#fff;margin:0 0 22px">Common questions about IT infrastructure consulting</h2>
  {faqs.map(f => (
    <details class="faq-item">
      <summary>{f.q}</summary>
      <p>{f.a}</p>
    </details>
  ))}
</section>

<section class="cta-band">
  <div>
    <div class="eyebrow" style="color:rgba(255,255,255,0.8)">// LET'S ASSESS IT</div>
    <h2>Let's assess what you have.</h2>
    <p>Free on-site IT infrastructure consultation across Greater LA.</p>
  </div>
  <a href="/contact" class="btn-dark">Request an assessment</a>
</section>

</Layout>
