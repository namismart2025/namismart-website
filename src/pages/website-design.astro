---
import Layout from '../layouts/Layout.astro';
import InnerHero from '../components/InnerHero.astro';
import { Image, getImage } from 'astro:assets';
import heroImage from '../assets/images/website-design-hero-mockup.png';

import namivisaHome from '../assets/images/portfolio/namivisa-desktop.png';
import namivisaMobile from '../assets/images/portfolio/namivisa-mobile.png';
import namivisaDashboard from '../assets/images/portfolio/namivisa-dashboard-desktop.png';
import namivisaProgress from '../assets/images/portfolio/namivisa-progress-desktop.png';
import namivisaMetrics from '../assets/images/portfolio/namivisa-metrics-desktop.png';
import namivisaAi from '../assets/images/portfolio/namivisa-ai-desktop.png';

import casaPriveeHome from '../assets/images/portfolio/casaprivee-desktop.png';
import casaPriveeMobile from '../assets/images/portfolio/casaprivee-mobile.png';
import casaPriveeProperties from '../assets/images/portfolio/casaprivee-properties-desktop.png';
import casaPriveeDetail from '../assets/images/portfolio/casaprivee-detail-desktop.png';
import casaPriveeEventTypes from '../assets/images/portfolio/casaprivee-eventtypes-desktop.png';
import casaPriveeHowItWorks from '../assets/images/portfolio/casaprivee-howitworks-desktop.png';

import namismartHome from '../assets/images/portfolio/namismart-desktop.png';
import namismartMobile from '../assets/images/portfolio/namismart-mobile.png';
import namismartSecurity from '../assets/images/portfolio/namismart-security-desktop.png';
import namismartProjects from '../assets/images/portfolio/namismart-projects-desktop.png';
import namismartContact from '../assets/images/portfolio/namismart-contact-desktop.png';

const portfolioSource = [
  {
    key: 'namivisa',
    cat: 'FITNESS / WEB APP',
    title: 'NaMiVisa — Private Workout Journal',
    desc: 'A fast, private workout-logging app with progress insights, streaks, and PR tracking — five pages shown below, straight from the live public demo.',
    tags: ['New Build', 'Web App', 'Mobile-First'],
    url: 'https://www.namivisa.com/',
    mobile: namivisaMobile,
    pages: [
      { src: namivisaHome, label: 'Homepage' },
      { src: namivisaDashboard, label: 'Dashboard' },
      { src: namivisaProgress, label: 'Progress' },
      { src: namivisaMetrics, label: 'Body Metrics' },
      { src: namivisaAi, label: 'AI Coach' },
    ],
  },
  {
    key: 'casaprivee',
    cat: 'REAL ESTATE / EVENTS',
    title: 'Casa Privée — Luxury Property Rentals',
    desc: 'A curated booking site for private luxury residences available for weddings, celebrations, and productions.',
    tags: ['New Build', 'Bookings', 'In Development'],
    url: 'https://casaprivee.vercel.app/',
    mobile: casaPriveeMobile,
    pages: [
      { src: casaPriveeHome, label: 'Homepage' },
      { src: casaPriveeProperties, label: 'Properties' },
      { src: casaPriveeDetail, label: 'Property Detail' },
      { src: casaPriveeEventTypes, label: 'Event Types' },
      { src: casaPriveeHowItWorks, label: 'How It Works' },
    ],
  },
  {
    key: 'namismart',
    cat: 'THIS SITE',
    title: 'NaMiSmart — Security & Networking',
    desc: "The site you're on right now — fast, modern, and built the same way we engineer a network.",
    tags: ['Live Site', '99 Performance Score', 'SEO-Ready'],
    url: 'https://www.namismart.com/',
    mobile: namismartMobile,
    pages: [
      { src: namismartHome, label: 'Homepage' },
      { src: namismartSecurity, label: 'Security Cameras' },
      { src: namismartProjects, label: 'Project Gallery' },
      { src: namismartContact, label: 'Contact (spam-protected)' },
    ],
  },
];

// The card thumbnail only needs a small image, but the in-page gallery
// needs full-size renditions — reusing the thumbnail-sized image for the
// expanded view made it blurry, so every gallery/thumb image gets its own
// properly-sized rendition here.
const portfolio = await Promise.all(portfolioSource.map(async (p) => {
  const coverDesktop = await getImage({ src: p.pages[0].src, width: 800, format: 'webp' });
  const coverMobile = await getImage({ src: p.mobile, width: 180, format: 'webp' });

  const galleryPages = await Promise.all(p.pages.map(async (page) => {
    const full = await getImage({ src: page.src, width: 1440, format: 'webp' });
    const thumb = await getImage({ src: page.src, width: 200, format: 'webp' });
    return { label: page.label, full: full.src, thumb: thumb.src, mobile: false };
  }));
  const mobileFull = await getImage({ src: p.mobile, width: 600, format: 'webp' });
  const mobileThumb = await getImage({ src: p.mobile, width: 120, format: 'webp' });

  const gallery = [...galleryPages, { label: 'Mobile view', full: mobileFull.src, thumb: mobileThumb.src, mobile: true }];

  return {
    ...p,
    coverDesktopSrc: coverDesktop.src,
    coverMobileSrc: coverMobile.src,
    gallery,
  };
}));

const faqs = [
  {
    q: 'How much does a new business website cost?',
    a: 'It depends on the number of pages, whether you need e-commerce or booking features, and how much content/photography you already have. We give every project a clear, itemized quote up front — no vague "starting at" pricing and no surprise invoices later.'
  },
  {
    q: 'How long does it take to build a website?',
    a: 'A standard small-business site typically takes a few weeks from kickoff to launch. Larger sites with e-commerce, custom features, or a lot of content take longer. We give you a firm timeline as part of the quote.'
  },
  {
    q: 'Can you redesign my existing website instead of starting from scratch?',
    a: 'Yes — redesigns are one of the most common projects we take on. We can rebuild an outdated site on modern, fast technology while keeping the content, structure, and SEO history you\'ve already built.'
  },
  {
    q: 'Do you handle hosting and the domain, or do I need my own?',
    a: 'Either works. We can set up and manage hosting and your domain for you, or build the site to hand off to your existing setup — whatever is easiest for how you run your business.'
  },
  {
    q: 'Will my website actually show up on Google?',
    a: 'Every site we build starts with solid SEO fundamentals — fast load times, proper page structure, mobile-friendly design, and correct metadata — the technical groundwork search engines and AI assistants actually check. Ranking for competitive terms takes ongoing content work too, which we can help plan.'
  },
  {
    q: 'What happens after the site launches — can I make changes myself?',
    a: 'Yes. We build sites you can update yourself for simple edits, and we\'re also available for ongoing changes, new pages, or ongoing support if you\'d rather not touch it.'
  }
];
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};
const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Website Design & Development",
  "name": "Website Design & Development — Los Angeles",
  "provider": { "@type": "LocalBusiness", "name": "NaMiSmart", "telephone": "+1-818-612-4117", "url": "https://namismart.com" },
  "areaServed": { "@type": "City", "name": "Los Angeles" },
  "description": "Fast, modern websites designed and built for small and local businesses across Greater Los Angeles.",
  "offers": { "@type": "Offer", "priceCurrency": "USD", "description": "Free consultation and quote" }
};
---

<Layout title="Website Design & Development Los Angeles" description="Fast, modern websites designed and built for small and local businesses across Greater Los Angeles." ogImage="/images/og/og-website-design.png" breadcrumbs={[{name:'Home',url:'/'},{name:'Website Design',url:'/website-design'}]}>

<!-- This page's CSS (~500 lines: portfolio grid, lightbox, FAQ accordion, etc.)
     is served as its own static stylesheet rather than an Astro <style>
     block. astro.config.mjs sets vite.build.cssCodeSplit: false, which
     merges every page's <style> block into ONE sitewide, render-blocking
     stylesheet — so a page-scoped block here would bloat that shared file
     on every other page too, even though only this page uses these rules. -->
<link rel="stylesheet" href="/styles/website-design.css" />

<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
<script type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} />

<InnerHero
  breadcrumb="WEBSITE DESIGN"
  eyebrow="// WEBSITE DESIGN & DEVELOPMENT"
  title="Websites engineered to"
  titleBlue="load fast and get found."
  subtitle="Most web designers hand you a template. We engineer a site the same way we engineer a network — fast, structured, and built to actually perform, for small and local businesses across Greater Los Angeles."
  tags={['MODERN & FAST', 'MOBILE-FIRST', 'SEO FOUNDATIONS', 'AI-SEARCH READY', 'BUILT TO CONVERT']}
  ctaLabel="Request a Free Consultation →"
  ctaHref="/contact"
  secondaryLabel="See Examples"
  secondaryHref="/projects"
  image={heroImage}
  imageAlt="Stylized browser window showing a modern website layout"
  statusLabel="LIVE · 99 PERFORMANCE SCORE"
  statusColor="#34E7A8"
/>

<section class="sec">
  <div class="intro-block">
    <div class="eyebrow">// WEBSITE DESIGN — LOS ANGELES</div>
    <p>NaMiSmart designs and builds websites for small and local businesses across Burbank and Greater Los Angeles. Every project starts with a real conversation about what the site needs to do — win calls, book jobs, sell products — rather than a generic template stretched to fit. The site you're reading right now is one of ours: fast, clean, and built the same way we build a network — planned first, engineered second, so it actually holds up. That matters even more for practices where trust is the entire sale — see how that plays out for <a href="/blog/website-design-for-law-firms-and-medical-dental-practices">law firms and medical or dental practices</a>.</p>
  </div>
</section>

<section class="sec">
  <div class="eyebrow">// WHAT'S INCLUDED</div>
  <div class="sys-grid">
    <div class="sys-card"><h3>Design &amp; Build</h3><p>Custom design and development on fast, modern technology — no bloated page builders or plugin pile-ups slowing you down.</p></div>
    <div class="sys-card"><h3>Redesigns</h3><p>Rebuild an outdated or slow site on modern technology while keeping the content and SEO equity you've already earned.</p></div>
    <div class="sys-card"><h3>Launch &amp; Support</h3><p>Domain and hosting setup, a smooth launch, and ongoing edits or support after the site is live.</p></div>
  </div>
</section>

<section class="sec">
  <div class="eyebrow">// BUILT RIGHT, NOT JUST PRETTY</div>
  <h2 style="font-family:'Archivo',sans-serif;font-weight:800;font-size:34px;letter-spacing:-0.02em;color:#fff;margin:0 0 22px">What makes a site actually perform</h2>
  <div class="grid3">
    <div class="card"><h3>Real page speed</h3><p>Optimized images and lean code — not a 15-second load time on a phone.</p></div>
    <div class="card"><h3>Mobile-first layout</h3><p>Built for the phone first, since that's where most of your customers are.</p></div>
    <div class="card"><h3>Clean structure &amp; schema</h3><p>Proper headings and markup so search engines understand exactly what you offer.</p></div>
    <div class="card"><h3>AI-search readiness</h3><p>Clear, direct content structured so AI assistants like Google AI, ChatGPT, and Perplexity can find and cite your business.</p></div>
    <div class="card"><h3>Built to convert</h3><p>Clear calls to action designed to turn visitors into calls, quotes, and bookings.</p></div>
    <div class="card"><h3>Easy to maintain</h3><p>Update your own content, or let us handle changes — your choice.</p></div>
  </div>
</section>

<section class="sec">
  <div class="grid2">
    <div class="card-lg">
      <div class="eyebrow">// WHY IT MATTERS</div>
      <h3>A slow, outdated site is worse than none.</h3>
      <p>A site that takes too long to load, looks broken on a phone, or doesn't say clearly what you do costs you customers before they ever call. We design for the moment someone lands on your site looking for exactly what you offer — clear, fast, and built to earn the call.</p>
    </div>
    <div class="tag-row">
      <div class="tag-row-item"><span class="tag-lbl">SPEED</span><span>engineered to load fast, not just look fast</span></div>
      <div class="tag-row-item"><span class="tag-lbl">CLARITY</span><span>says what you do in the first five seconds</span></div>
      <div class="tag-row-item"><span class="tag-lbl">FOUND</span><span>structured for search &amp; AI assistants</span></div>
    </div>
  </div>
</section>

<section class="sec">
  <div class="eyebrow">// SEE THE WORK</div>
  <h2 style="font-family:'Archivo',sans-serif;font-weight:800;font-size:28px;letter-spacing:-0.02em;color:#fff;margin:0 0 8px">Sites we've designed and built</h2>
  <p style="font-size:13.5px;line-height:1.6;color:#8B98AE;margin:0 0 22px">Click into any project to browse it right here — multiple pages, desktop and mobile, no need to leave this site.</p>
  <div class="port-grid">
    {portfolio.map(p => (
      <div class="port-card" data-url={p.url} data-title={p.title} data-cat={p.cat} data-desc={p.desc} data-gallery={JSON.stringify(p.gallery)}>
        <button type="button" class="port-shot port-shot-btn" aria-label={`Browse screenshots of ${p.title}`}>
          <img src={p.coverDesktopSrc} alt={`${p.title} — desktop view`} loading="lazy" class="port-desktop" />
          <div class="port-mobile-inset">
            <img src={p.coverMobileSrc} alt={`${p.title} — mobile view`} loading="lazy" />
          </div>
          <span class="port-zoom-hint">Browse {p.pages.length} pages ⤢</span>
        </button>
        <div class="port-body">
          <div class="port-cat">{p.cat}</div>
          <h3>{p.title}</h3>
          <p>{p.desc}</p>
          <div class="port-tags">
            {p.tags.map(t => <span class="ptag">{t}</span>)}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<div class="port-lightbox" id="port-lightbox">
  <div class="port-lightbox-panel">
    <button type="button" class="port-lightbox-close" id="port-lightbox-close" aria-label="Close">✕</button>
    <div class="port-lightbox-cat" id="port-lightbox-cat"></div>
    <h3 class="port-lightbox-title" id="port-lightbox-title"></h3>
    <p class="port-lightbox-desc" id="port-lightbox-desc"></p>

    <div class="port-lightbox-main">
      <button type="button" class="port-lightbox-nav prev" id="port-lightbox-prev" aria-label="Previous page">‹</button>
      <div class="port-lightbox-stage">
        <img id="port-lightbox-img" alt="" />
        <div class="port-lightbox-counter" id="port-lightbox-counter"></div>
      </div>
      <button type="button" class="port-lightbox-nav next" id="port-lightbox-next" aria-label="Next page">›</button>
    </div>

    <div class="port-lightbox-thumbs" id="port-lightbox-thumbs"></div>

    <a href="#" target="_blank" rel="noopener" class="port-lightbox-visit" id="port-lightbox-visit">View live at <span id="port-lightbox-visit-host"></span> ↗</a>
  </div>
</div>

<script>
  const lightbox = document.getElementById('port-lightbox');
  const lbCat = document.getElementById('port-lightbox-cat');
  const lbTitle = document.getElementById('port-lightbox-title');
  const lbDesc = document.getElementById('port-lightbox-desc');
  const lbImg = document.getElementById('port-lightbox-img');
  const lbCounter = document.getElementById('port-lightbox-counter');
  const lbThumbs = document.getElementById('port-lightbox-thumbs');
  const lbVisit = document.getElementById('port-lightbox-visit');
  const lbVisitHost = document.getElementById('port-lightbox-visit-host');
  const lbClose = document.getElementById('port-lightbox-close');
  const lbPrev = document.getElementById('port-lightbox-prev');
  const lbNext = document.getElementById('port-lightbox-next');

  let currentGallery = [];
  let currentIndex = 0;

  function showImage(i) {
    if (!currentGallery.length) return;
    currentIndex = (i + currentGallery.length) % currentGallery.length;
    const item = currentGallery[currentIndex];
    lbImg.src = item.full;
    lbImg.alt = item.label;
    lbCounter.textContent = `${currentIndex + 1} / ${currentGallery.length} — ${item.label}`;
    [...lbThumbs.children].forEach((t, idx) => t.classList.toggle('active', idx === currentIndex));
    const activeThumb = lbThumbs.children[currentIndex];
    if (activeThumb) activeThumb.scrollIntoView({ block: 'nearest', inline: 'center' });
  }

  function openLightbox(card) {
    currentGallery = JSON.parse(card.dataset.gallery || '[]');
    lbCat.textContent = card.dataset.cat || '';
    lbTitle.textContent = card.dataset.title || '';
    lbDesc.textContent = card.dataset.desc || '';

    lbThumbs.innerHTML = '';
    currentGallery.forEach((item, idx) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'port-lightbox-thumb';
      btn.setAttribute('aria-label', item.label);
      const img = document.createElement('img');
      img.src = item.thumb;
      img.alt = item.label;
      btn.appendChild(img);
      btn.addEventListener('click', () => showImage(idx));
      lbThumbs.appendChild(btn);
    });

    try {
      const host = new URL(card.dataset.url).hostname.replace(/^www\./, '');
      lbVisitHost.textContent = host;
      lbVisit.href = card.dataset.url || '#';
    } catch {
      lbVisit.style.display = 'none';
    }

    showImage(0);
    lightbox?.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    lightbox?.classList.remove('open');
    document.body.style.overflow = '';
  }

  document.querySelectorAll('.port-shot-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const card = btn.closest('.port-card');
      if (card) openLightbox(card);
    });
  });

  lbClose?.addEventListener('click', closeLightbox);
  lbPrev?.addEventListener('click', () => showImage(currentIndex - 1));
  lbNext?.addEventListener('click', () => showImage(currentIndex + 1));
  lightbox?.addEventListener('click', (e) => { if (e.target === lightbox) closeLightbox(); });
  document.addEventListener('keydown', (e) => {
    if (!lightbox?.classList.contains('open')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') showImage(currentIndex - 1);
    if (e.key === 'ArrowRight') showImage(currentIndex + 1);
  });
</script>

<section class="sec" style="padding-bottom:10px">
  <div class="callout">
    <div>
      <h3>Already have a website?</h3>
      <p>We audit existing sites for speed, mobile issues, and outdated design, and can rebuild what's holding you back while keeping what's already working.</p>
    </div>
    <a href="/contact">Request a Free Audit →</a>
  </div>
</section>

<section class="sec">
  <div class="eyebrow">// WEBSITE DESIGN FAQ</div>
  <h2 style="font-family:'Archivo',sans-serif;font-weight:800;font-size:28px;letter-spacing:-0.02em;color:#fff;margin:0 0 22px">Common questions about website design</h2>
  {faqs.map(f => (
    <details class="faq-item">
      <summary>{f.q}</summary>
      <p>{f.a}</p>
    </details>
  ))}
</section>

<section class="cta-band">
  <div>
    <div class="eyebrow" style="color:rgba(255,255,255,0.8)">// LET'S BUILD IT</div>
    <h2>Let's design your website.</h2>
    <p>Free consultation &amp; quote across Greater LA.</p>
  </div>
  <a href="/contact" class="btn-dark">Request a consultation</a>
</section>

</Layout>
